<Window x:Class="Pr24_WPFSimpleGUI_øvelse2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pr24_WPFSimpleGUI_øvelse2"
        mc:Ignorable="d"
        Title="MainWindow" Height="300" Width="500">
    <Grid>
        <Label Content="1" HorizontalAlignment="Left" Margin="95,62,0,0" VerticalAlignment="Top"/>
        <Label Content="2" HorizontalAlignment="Left" Margin="95,106,0,0" VerticalAlignment="Top"/>
        <Label Content="3" HorizontalAlignment="Left" Margin="95,152,0,0" VerticalAlignment="Top"/>
        <Label Content="4" HorizontalAlignment="Left" Margin="95,196,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="Line1TextBox" HorizontalAlignment="Left" Margin="165,66,0,0" TextWrapping="Wrap" Text="Line 1" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="Line2TextBox" HorizontalAlignment="Left" Margin="165,110,0,0" TextWrapping="Wrap" Text="Line 2" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="Line3TextBox" HorizontalAlignment="Left" Margin="165,156,0,0" TextWrapping="Wrap" Text="Line 3" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="Line4TextBox" HorizontalAlignment="Left" Margin="165,200,0,0" TextWrapping="Wrap" Text="Line 4" VerticalAlignment="Top" Width="120"/>
        <Button x:Name="ScrollUpButton" Content="Scroll Up" HorizontalAlignment="Left" Margin="345,91,0,0" VerticalAlignment="Top" Width="75" Click="ScrollUpButton_Click"/>
        <Button x:Name="ClearButton" Content="Clear" HorizontalAlignment="Left" Margin="345,137,0,0" VerticalAlignment="Top" Width="75" Click="ClearButton_Click"/>
        <Button x:Name="ScrollDownButton" Content="Scroll Down" HorizontalAlignment="Left" Margin="345,181,0,0" VerticalAlignment="Top" Width="75" Click="ScrollDownButton_Click"/>

    </Grid>
</Window>
