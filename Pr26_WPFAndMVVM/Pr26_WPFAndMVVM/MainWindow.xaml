<Window x:Class="Pr26_WPFAndMVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pr26_WPFAndMVVM"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Label Content="{Binding ElementName=SourceTextBox, Path=Text}" HorizontalAlignment="Left" Margin="80,69,0,0" VerticalAlignment="Top" Width="140" Height="28"/>
        <TextBox x:Name="SourceTextBox" HorizontalAlignment="Left" Margin="253,73,0,0" TextWrapping="Wrap" Text="TextBox1" VerticalAlignment="Top" Width="347"/>
        <TextBox x:Name="TextBox2" HorizontalAlignment="Left" Margin="80,175,0,0" TextWrapping="Wrap" Text="{Binding ElementName=TextBox3, Path=Text, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" VerticalAlignment="Top" Width="229"/>
        <TextBox x:Name="TextBox3" HorizontalAlignment="Left" Margin="400,175,0,0" TextWrapping="Wrap" Text="TextBox3" VerticalAlignment="Top" Width="229"/>

    </Grid>
</Window>
